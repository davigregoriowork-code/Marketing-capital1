  <script>
"use strict";

/* =========================
   UTILIDADES
========================= */
const $ = id => document.getElementById(id);
function money(n){const c=window.__CM_CCY__||"BRL";return c+" "+Number(n||0).toLocaleString("pt-BR",{minimumFractionDigits:2,maximumFractionDigits:2});}
const num = n => Number(n||0).toLocaleString("pt-BR",{maximumFractionDigits:2});
const clamp = (x,a,b) => Math.max(a,Math.min(b,x));
const rnd = (a,b) => a + Math.random()*(b-a);
const pick = a => a[Math.floor(Math.random()*a.length)];
const esc = s => String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));

function toast(msg){
  const t=$("toast"); t.textContent=msg; t.classList.add("show");
  clearTimeout(toast.timer); toast.timer=setTimeout(()=>t.classList.remove("show"),2200);
}

/* =========================
   ESTADO
========================= */
const S={
  tick:0,speed:5,paused:false,currentPage:"inicio",selectedStock:null,
  player:{
    cash:100000,bank:0,loans:0,
    stocks:{},stockCost:{},
    bonds:[],crypto:{},history:[],netWorth:100000,
    _stockVal:0,_bondVal:0,_cryptoVal:0,
    name:"",countryId:"BR",currency:"BRL",fxRate:5,
    stockBasis:{},cryptoBasis:{},debts:[],card:null,score:650,
    taxes:{paid:0,accrued:0,byType:{income:0,capital:0,interest:0,profit:0}},taxLog:[],
    companies:[],ipos:[],income:0,expenses:0
  },
  news:[],
  orders:[],
  lastInterestTick:0
};

const countries=[
  {id:"BR",name:"Brasil",ccy:"BRL",gdp:2100,inflation:6.2,unemployment:8.5,rate:12,growth:2.1,debt:75,confidence:52,fx:5},
  {id:"US",name:"Estados Unidos",ccy:"USD",gdp:26000,inflation:2.8,unemployment:4,rate:4.5,growth:2.4,debt:120,confidence:61,fx:1},
  {id:"JP",name:"Japão",ccy:"JPY",gdp:4200,inflation:.9,unemployment:2.6,rate:.3,growth:.6,debt:230,confidence:48,fx:150},
  {id:"DE",name:"Alemanha",ccy:"EUR",gdp:4400,inflation:2.1,unemployment:5.4,rate:3.2,growth:1.1,debt:65,confidence:57,fx:.92},
  {id:"UK",name:"Reino Unido",ccy:"GBP",gdp:3300,inflation:3,unemployment:4.3,rate:4,growth:1.4,debt:98,confidence:53,fx:.78}
];

const sectors=["Bancos","Tecnologia","Energia","Mineração","Indústria","Varejo","Saúde","Telecom","Agricultura","Transporte"];
const names=["Alpha","Nova","Vetor","Prisma","Zenith","Orion","Solaris","Meridian","Atlas","Cobalt","Titanium","Norte","Cardinal","Vortex","Apex","Lumen","Quantum","Fenix","Aurora","Bastion"];
let companies=[];

for(let i=0;i<20;i++){
  const country=countries[i%countries.length], sector=sectors[i%sectors.length];
  const price=+rnd(8,220).toFixed(2), shares=Math.floor(rnd(5,80))*1e6;
  companies.push({
    id:"C"+i,ticker:(names[i].slice(0,3)+i).toUpperCase(),
    name:names[i]+" "+sector+" S.A.",country:country.id,sector,
    price,lastPrice:price,open:price,high:price,low:price,shares,volume:0,
    revenue:price*shares/1e6*rnd(.4,1.2),
    profit:price*shares/1e6*rnd(.02,.15),
    debt:price*shares/1e6*rnd(.1,.6),
    growth:rnd(-2,15),divYield:rnd(0,6),volatility:rnd(.4,2.2),
    hist:[price],bids:[],asks:[]
  });
}

function seedBook(c){
  c.bids=[];c.asks=[];
  for(let i=1;i<=8;i++){
    c.bids.push({price:+(c.price*(1-.0018*i)).toFixed(2),qty:Math.floor(rnd(100,800))});
    c.asks.push({price:+(c.price*(1+.0018*i)).toFixed(2),qty:Math.floor(rnd(100,800))});
  }
}
companies.forEach(seedBook);

const bonds=countries.map(c=>({
  id:"B-"+c.id,issuer:"Tesouro "+c.name,country:c.id,ccy:c.ccy,
  rate:c.rate,years:c.id==="US"?10:5,face:1000,price:1000
}));

const cryptos=[
  {id:"BTC",name:"BitCore",tk:"BTC*",price:38000,supply:19e6,cap:0,volat:3.5,hist:[38000]},
  {id:"ETH",name:"Etheria",tk:"ETH*",price:2200,supply:120e6,cap:0,volat:3,hist:[2200]},
  {id:"NVA",name:"NovaCoin",tk:"NVA",price:.85,supply:5e9,cap:0,volat:5,hist:[.85]},
  {id:"MTA",name:"MetaCoin",tk:"MTA",price:12.4,supply:400e6,cap:0,volat:4.2,hist:[12.4]}
];
cryptos.forEach(c=>c.cap=c.price*c.supply);

const agents=Array.from({length:50},()=>({
  type:pick(["conservador","trader","fundamentalista","especulador"]),
  cash:rnd(50000,900000)
}));

/* =========================
   LIVRO DE OFERTAS
========================= */
function bestBid(c){return c.bids.length?Math.max(...c.bids.map(o=>o.price)):c.price*.995}
function bestAsk(c){return c.asks.length?Math.min(...c.asks.map(o=>o.price)):c.price*1.005}

function refillBook(c){
  c.bids=c.bids.filter(o=>o.qty>0);
  c.asks=c.asks.filter(o=>o.qty>0);
  while(c.bids.length<8){
    const p=Math.max(.01,bestBid(c)*(1-rnd(.001,.004)));
    c.bids.push({price:+p.toFixed(2),qty:Math.floor(rnd(80,600))});
  }
  while(c.asks.length<8){
    const p=bestAsk(c)*(1+rnd(.001,.004));
    c.asks.push({price:+p.toFixed(2),qty:Math.floor(rnd(80,600))});
  }
}

function matchOrder(c,side,limitPrice,qty,market=false,ownerId=null){
  qty=Math.floor(Number(qty));
  if(qty<=0)return {filled:0,cost:0,remaining:0};

  const book=side==="buy"?c.asks:c.bids;
  book.sort((a,b)=>side==="buy"?a.price-b.price:b.price-a.price);

  let remaining=qty,cost=0,filled=0;
  for(const o of book){
    if(remaining<=0)break;
    const crosses=market || (side==="buy"?limitPrice>=o.price:limitPrice<=o.price);
    if(!crosses)break;

    const q=Math.min(remaining,o.qty);
    filled+=q; remaining-=q; o.qty-=q;
    cost+=q*o.price;
    c.lastPrice=c.price;
    c.price=o.price;
    c.high=Math.max(c.high,o.price);
    c.low=Math.min(c.low,o.price);
    c.volume+=q;
    /* Se a oferta consumida pertence a uma ordem pendente do jogador (ordem
       limitada que ficou no livro), liquida essa fatia imediatamente:
       o jogador precisa receber o dinheiro (venda) ou as ações (compra)
       na hora em que sua ordem é executada por outra parte. */
    if(o.owner==="player" && o.orderId)settlePlayerOrderFill(o.orderId,q,o.price);
  }

  c.bids=c.bids.filter(o=>o.qty>0);
  c.asks=c.asks.filter(o=>o.qty>0);

  if(remaining>0 && !market){
    const own=side==="buy"?c.bids:c.asks;
    const entry={price:+limitPrice.toFixed(2),qty:remaining};
    if(ownerId){entry.owner="player";entry.orderId=ownerId;}
    own.push(entry);
  }

  refillBook(c);
  return {filled,cost,remaining};
}

/* Liquida o preenchimento (total ou parcial) de uma ordem pendente do jogador
   que estava aguardando no livro de ofertas. Fonte única de verdade: a ordem
   em S.orders. Sem isso, dinheiro/ações apareciam ou desapareciam do nada
   quando um agente cruzava com uma ordem limitada do jogador. */
function settlePlayerOrderFill(orderId,qty,price){
  const idx=(S.orders||[]).findIndex(o=>o.id===orderId);
  if(idx<0)return;
  const order=S.orders[idx];
  qty=Math.min(qty,order.qty);
  if(order.side==="buy"){
    const cost=qty*price;
    S.player.stocks[order.ticker]=(S.player.stocks[order.ticker]||0)+qty;
    S.player.stockCost[order.ticker]=(S.player.stockCost[order.ticker]||0)+cost;
    S.player.stockBasis[order.ticker]=(S.player.stockBasis[order.ticker]||0)+cost;
  }else{
    const gain=(price-(order.costPerShare||0))*qty;
    const tax=applyCapitalTax(gain);
    S.player.cash+=qty*price-tax;
  }
  order.qty-=qty;
  if(order.qty<=0.0001){
    S.orders.splice(idx,1);
    if(a.type==="conservador" && Math.random()<.75)continue;

    const qty=Math.max(1,Math.floor(rnd(20,500)));
    const p=side==="buy"?bestAsk(c):bestBid(c);
    matchOrder(c,side,p,qty,true);
  }

  cryptos.forEach(c=>{
    const move=((Math.random()-.5)*c.volat + (Math.random()-.5)*c.volat*.5)/100;
    c.price=Math.max(.0001,+(c.price*(1+move)).toFixed(c.price<10?4:2));
    c.cap=c.price*c.supply;
  });

  countries.forEach(c=>{
    if(c.id==="US")return;
    const flow=(Math.random()-.48)*.008;
    c.fx=+(c.fx*(1+flow)).toFixed(4);
  });
}

/* =========================
   MACROECONOMIA
========================= */
function triggerEvent(){
  const c=pick(countries);
  const type=pick(["growth","inflation","rate","confidence"]);
  let msg="";

  if(type==="growth"){
    c.growth=clamp(c.growth+rnd(.2,.7),-5,8);
    c.confidence=clamp(c.confidence+2,0,100);
    msg=`${c.name}: atividade econômica veio acima do esperado.`;
  }else if(type==="inflation"){
    c.inflation=clamp(c.inflation+rnd(.2,.7),-1,20);
    c.confidence=clamp(c.confidence-1,0,100);
    msg=`${c.name}: inflação acelerou no período.`;
  }else if(type==="rate"){
    const old=c.rate;
    c.rate=clamp(c.rate+pick([-.5,.25,.5]),.1,20);
    msg=`${c.name}: Banco Central alterou a taxa básica de ${old.toFixed(2)}% para ${c.rate.toFixed(2)}%.`;
  }else{
    c.confidence=clamp(c.confidence+pick([-5,-3,3,5]),0,100);
    msg=`${c.name}: mercado revisou as expectativas de confiança.`;
  }

  if(Math.random()<.55){
    const pool=companies.filter(x=>x.country===c.id);
    const co=pick(pool);
    const shock=(c.rate>10?-.004:.004)*rnd(1,4);
   TEMPO
========================= */
function fmtClock(){
  const day=Math.floor(S.tick/1440)+1;
  const hour=Math.floor((S.tick%1440)/60);
  const min=S.tick%60;
  const year=Math.floor((day-1)/360)+1;
  const d=((day-1)%30)+1;
  const month=Math.floor(((day-1)%360)/30)+1;
  return `Ano ${year} · M${month} · D${d} · ${String(hour).padStart(2,"0")}:${String(min).padStart(2,"0")}`;
}

function tick(){
  S.tick++;agentsTrade();
  companies.forEach(c=>{const pressure=(Math.random()-.5)*c.volatility/100;c.price=Math.max(.5,+(c.price*(1+pressure)).toFixed(2));c.high=Math.max(c.high,c.price);c.low=Math.min(c.low,c.price);c.hist.push(c.price);if(c.hist.length>300)c.hist.shift()});
  cryptos.forEach(c=>{c.hist.push(c.price);if(c.hist.length>300)c.hist.shift()});
  if(S.tick%60===0)updateBonds();
  if(S.tick%43200===0){accrueMonthly();creditCycle();}
  if(Math.random()<.025)triggerEvent();
  processDebtCycle();recalcPortfolio();renderTop();updateLiveAction();
  if(S.tick%20===0)saveGame(false);
}
function recalcPortfolio(){
  let stockVal=0;Object.entries(S.player.stocks).forEach(([tk,q])=>{const c=companies.find(x=>x.ticker===tk);if(c)stockVal+=c.price*q});
  let bondVal=0;S.player.bonds.forEach(p=>{const b=bonds.find(x=>x.id===p.id);if(b)bondVal+=b.price*p.qty});
  let cryptoVal=0;Object.entries(S.player.crypto).forEach(([tk,q])=>{const c=cryptos.find(x=>x.tk===tk);if(c)cryptoVal+=c.price*q});
  const companyVal=(S.player.companies||[]).reduce((a,x)=>a+(x.equityValue||0),0);
  const debt=totalDebt();S.player._stockVal=stockVal;S.player._bondVal=bondVal;S.player._cryptoVal=cryptoVal;S.player._debtVal=debt;S.player.netWorth=S.player.cash+S.player.bank+stockVal+bondVal+cryptoVal+companyVal-debt;
  S.player.history.push(S.player.netWorth);if(S.player.history.length>300)S.player.history.shift();updateScore();
}
let loop=null;
function startLoop(){
  clearInterval(loop);
  loop=setInterval(()=>{
    if(!S.paused)for(let i=0;i<S.speed;i++)tick();
  },1000);
}

/* =========================
   GRÁFICOS
========================= */
function sparkline(hist,w=700,h=180){
  const a=hist?.length?hist:[0,0];
  const min=Math.min(...a),max=Math.max(...a);
  const pts=a.map((v,i)=>{
    const x=i/(a.length-1||1)*w;
    const y=h-((v-min)/((max-min)||1))*h;
    return `${x},${y}`;
  }).join(" ");
  const col=a[a.length-1]>=a[0]?"#2fd989":"#ff5d6c";
  return `<svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" style="width:100%;height:100%">
    <polyline points="${pts}" fill="none" stroke="${col}" stroke-width="2"/>
  </svg>`;
}

/* =========================
   RENDER
========================= */
function setPage(p){
  S.currentPage=p;
  document.querySelectorAll("nav button").forEach(b=>b.classList.toggle("active",b.dataset.p===p));
  render(p);
}

document.querySelectorAll("nav button").forEach(b=>b.onclick=()=>setPage(b.dataset.p));

[1,5,10,50,100].forEach(sp=>{
  const b=document.createElement("button");
  b.textContent=sp+"x";
  b.onclick=()=>{
    S.speed=sp;
    document.querySelectorAll("#speedBtns button[data-speed]").forEach(x=>x.classList.remove("active"));
    b.classList.add("active");
    if(typeof saveGame==="function")saveGame(false);
  };
  b.dataset.speed=sp;
  if(sp===S.speed)b.classList.add("active");
  $("speedBtns").appendChild(b);
});

const pause=document.createElement("button");
pause.textContent="Pausar";pause.className="secondary";
