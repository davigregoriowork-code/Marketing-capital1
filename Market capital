const CM_SAVE_KEY="capital-market-save-v2";
const DEV_TEST_MODE={enabled:false,key:"CM-DEV-2026-TEST"};
const TAX_RULES={BR:{income:.275,capital:.15,interest:.15,profit:.20},US:{income:.24,capital:.15,interest:.24,profit:.21},JP:{income:.20,capital:.20,interest:.20,profit:.23},DE:{income:.25,capital:.25,interest:.25,profit:.15},UK:{income:.20,capital:.20,interest:.20,profit:.25}};
function pc(){return countries.find(c=>c.id===S.player.countryId)||countries[0]}
function localUSD(){return Number(S.player.fxRate)||pc().fx||1}
function setCurrency(){window.__CM_CCY__=S.player.currency||pc().ccy}
function usd500(){return 500*localUSD()}
function totalDebt(){return (S.player.debts||[]).reduce((a,d)=>a+Math.max(0,d.balance||0),0)+(S.player.loans||0)+(S.player.card?.bill||0)}
function activeDebts(){return (S.player.debts||[]).filter(d=>d.balance>0.005)}
function taxRate(k){return TAX_RULES[S.player.countryId]?.[k]||.15}
function addTax(type,amount,reason){amount=Math.max(0,Number(amount)||0);if(!amount)return;S.player.taxes=S.player.taxes||{paid:0,accrued:0,byType:{}};S.player.taxes.paid+=amount;S.player.taxes.byType[type]=(S.player.taxes.byType[type]||0)+amount;S.player.taxLog=S.player.taxLog||[];S.player.taxLog.unshift({tick:S.tick,type,amount,reason});S.player.taxLog=S.player.taxLog.slice(0,100)}
function normalizePlayer(){const c=pc();S.player.countryId=S.player.countryId||"BR";S.player.currency=c.ccy;S.player.fxRate=c.fx;S.player.stocks=S.player.stocks||{};S.player.stockCost=S.player.stockCost||{};S.player.stockBasis=S.player.stockBasis||{};S.player.bonds=S.player.bonds||[];S.player.crypto=S.player.crypto||{};S.player.cryptoBasis=S.player.cryptoBasis||{};S.player.history=S.player.history||[];S.player.debts=S.player.debts||[];S.player.taxes=S.player.taxes||{paid:0,accrued:0,byType:{}};S.player.taxLog=S.player.taxLog||[];S.player.companies=S.player.companies||[];S.player.ipos=S.player.ipos||[];setCurrency()}
function saveGame(show){if(!S.player.name)return;try{localStorage.setItem(CM_SAVE_KEY,JSON.stringify({version:2,state:{tick:S.tick,speed:S.speed,paused:S.paused,currentPage:S.currentPage,selectedStock:S.selectedStock,news:S.news,lastInterestTick:S.lastInterestTick,orders:S.orders},player:S.player,companies, bonds, cryptos, countries}));if(show)toast("Progresso salvo.")}catch(e){console.warn("localStorage",e)}}
function loadGame(){try{const raw=localStorage.getItem(CM_SAVE_KEY);if(!raw)return false;const d=JSON.parse(raw);if(!d.player?.name)return false;Object.assign(S,d.state||{});Object.assign(S.player,d.player);if(Array.isArray(d.companies)&&d.companies.length){companies.length=0;d.companies.forEach(c=>{companies.push(c);refillBook(c)})}if(Array.isArray(d.bonds)&&d.bonds.length){bonds.splice(0,bonds.length,...d.bonds)}if(Array.isArray(d.cryptos)&&d.cryptos.length){cryptos.splice(0,cryptos.length,...d.cryptos)}if(Array.isArray(d.countries)&&d.countries.length){countries.splice(0,countries.length,...d.countries)}normalizePlayer();recalcPortfolio();return true}catch(e){console.warn("Falha ao carregar",e);return false}}
function updateScore(){const card=S.player.card,util=card?.limit?card.used/card.limit:0,debts=activeDebts();let score=650;score+=Math.min(90,Math.max(0,S.player.netWorth)/Math.max(1,usd500())*15);score-=Math.min(180,util*220);score-=debts.filter(d=>d.overdue).length*55;if(!debts.length)score+=25;S.player.score=clamp(Math.round(score),300,900)}
function creditLimit(){return Math.max(100,Math.min(50000,usd500()*(S.player.score/650)+Math.max(0,S.player.netWorth)*.12))}
function applyCapitalTax(gain){if(gain<=0)return 0;const t=gain*taxRate("capital");addTax("capital",t,"Ganho de capital realizado");return t}
  if(!Number.isFinite(qty)||qty<=0)return toast("Quantidade inválida.");
  if(!market&&(!Number.isFinite(limit)||limit<=0))return toast("Preço limite inválido.");

  if(side==="buy"){
    if((market?bestAsk(c):limit)*qty>S.player.cash)return toast("Caixa insuficiente.");
  }else{
    const have=S.player.stocks[c.ticker]||0;
    const reserved=(S.orders||[]).filter(o=>o.ticker===c.ticker&&o.side==="sell").reduce((a,o)=>a+o.qty,0);
    if(have-reserved<qty)return toast("Ações insuficientes (parte já está reservada em ordens pendentes).");
  }

  const orderId=!market?("O"+S.tick+"-"+Date.now()+"-"+Math.random().toString(36).slice(2,7)):null;
  const r=matchOrder(c,side,market?0:limit,qty,market,orderId);
  if(r.filled<=0 && r.remaining<=0)return toast("Ordem não executada. Ela não cruzou o livro.");

  let msg="";
  if(r.filled>0){
    const avg=r.cost/r.filled;
    if(side==="buy"){
      S.player.cash-=r.cost;
      S.player.stocks[c.ticker]=(S.player.stocks[c.ticker]||0)+r.filled;
      S.player.stockCost[c.ticker]=(S.player.stockCost[c.ticker]||0)+r.cost;
      S.player.stockBasis[c.ticker]=(S.player.stockBasis[c.ticker]||0)+r.cost;
    }else{
      const oldQty=S.player.stocks[c.ticker]||0,oldCost=S.player.stockCost[c.ticker]||0,avgCost=oldQty?oldCost/oldQty:0,gain=(avg-avgCost)*r.filled,tax=applyCapitalTax(gain);
      S.player.cash+=r.cost-tax;
      S.player.stocks[c.ticker]=oldQty-r.filled;
      S.player.stockCost[c.ticker]=Math.max(0,oldCost-avgCost*r.filled);
      S.player.stockBasis[c.ticker]=Math.max(0,(S.player.stockBasis[c.ticker]||0)-avgCost*r.filled);
      if(S.player.stocks[c.ticker]<=0){delete S.player.stocks[c.ticker];delete S.player.stockCost[c.ticker];delete S.player.stockBasis[c.ticker]}
    }
    msg=`${side==="buy"?"Compra":"Venda"} executada: ${r.filled} ${c.ticker} a ${money(avg)}.`;
  }

  if(r.remaining>0 && !market && orderId){
    if(side==="buy"){
      /* Reserva o caixa do restante ao preço limite, para não poder ser gasto
         duas vezes enquanto a ordem aguarda no livro. */
      S.player.cash-=r.remaining*limit;
      S.orders.push({id:orderId,companyId:c.id,ticker:c.ticker,side,qty:r.remaining,price:limit});
    }else{
      /* Reserva (retira da carteira) as ações do restante, mantendo o custo
         médio por ação para apurar o imposto corretamente quando a ordem
         for liquidada mais tarde. */
      const oldQty=S.player.stocks[c.ticker]||0,oldCost=S.player.stockCost[c.ticker]||0,avgCost=oldQty?oldCost/oldQty:0;
      S.player.stocks[c.ticker]=Math.max(0,oldQty-r.remaining);
      S.player.stockCost[c.ticker]=Math.max(0,oldCost-avgCost*r.remaining);
      S.player.stockBasis[c.ticker]=Math.max(0,(S.player.stockBasis[c.ticker]||0)-avgCost*r.remaining);
window.cancelOrder=cancelOrder;
function requestCard(){if(S.player.card)return toast("Você já possui um cartão.");updateScore();S.player.card={limit:creditLimit(),used:0,bill:0,dueTick:S.tick+43200,interestRate:.03,late:false,payments:0,status:"Ativo"};saveGame(true);render("cartao")}
function useCard(){if(!S.player.card)return requestCard();const v=Number($("cardUseAmt")?.value)||0;if(v<=0||v>Math.max(0,S.player.card.limit-S.player.card.used))return toast("Valor inválido ou limite insuficiente.");S.player.card.used+=v;S.player.card.bill+=v;recalcPortfolio();saveGame(false);render("cartao")}
function payCard(){if(!S.player.card)return;const v=Math.min(Number($("cardPayAmt")?.value)||0,S.player.card.bill,S.player.cash);if(v<=0)return toast("Pagamento inválido.");S.player.cash-=v;S.player.card.bill-=v;S.player.card.used=Math.max(0,S.player.card.used-v);S.player.card.late=false;S.player.card.dueTick=S.tick+43200;S.player.card.payments++;recalcPortfolio();saveGame(false);render("cartao")}
function createDebt(type,amount,rate,term,label){amount=Number(amount)||0;term=Math.max(1,Math.floor(Number(term)||1));if(amount<=0)return null;const r=rate*Math.pow(1+rate,term)/(Math.pow(1+rate,term)-1||1);const d={id:"D"+Date.now()+Math.random(),type,label,original:amount,balance:amount,rateMonthly:rate,term,remaining:term,nextDue:S.tick+43200,installment:amount*r,overdue:false};S.player.debts.push(d);return d}
function requestFinancing(){const amount=Number($("finAmount")?.value)||0,term=Number($("finTerm")?.value)||0;if(amount<=0||term<=0)return toast("Informe valor e prazo.");updateScore();const max=usd500()*(S.player.score/650)+Math.max(0,S.player.netWorth)*.2;if(amount>max)return toast(`Limite estimado: ${money(max)}.`);const rate=.018+Math.max(0,650-S.player.score)/100000;createDebt("financiamento",amount,rate,term,"Financiamento pessoal");S.player.cash+=amount;recalcPortfolio();saveGame(false);render("dividas")}
function payDebt(id){const d=S.player.debts.find(x=>x.id===id);if(!d)return;const v=Math.min(d.installment,S.player.cash,d.balance);if(v<=0)return toast("Caixa insuficiente.");S.player.cash-=v;d.balance=Math.max(0,d.balance-v);d.remaining=Math.max(0,d.remaining-1);d.overdue=false;d.nextDue=S.tick+43200;recalcPortfolio();saveGame(false);render("dividas")}
function processDebtCycle(){if(S.player.card&&S.tick>=S.player.card.dueTick&&S.player.card.bill>0){S.player.card.bill*=1+S.player.card.interestRate;S.player.card.used=S.player.card.bill;S.player.card.late=true;S.player.card.dueTick=S.tick+43200}for(const d of S.player.debts||[]){if(d.balance>0&&S.tick>=d.nextDue){d.balance*=1+d.rateMonthly;d.overdue=true;d.nextDue=S.tick+43200;d.remaining=Math.max(0,d.remaining-1)}}}
function creditCycle(){updateScore();if(S.player.card){S.player.card.limit=creditLimit();if(S.player.card.limit<S.player.card.used)S.player.card.limit=S.player.card.used}}
function accrueMonthly(){
  if(S.tick%43200!==0)return;
  const bankInterest=S.player.bank*.003;S.player.bank+=bankInterest;
  const loanInterest=S.player.loans*.018;S.player.loans+=loanInterest;
  const bondInterest=(S.player._bondVal||0)*(pc().rate/100)/12;
  const tax=bondInterest*taxRate("interest");
  if(bondInterest>0){S.player.taxes.accrued+=tax;S.player.cash+=bondInterest-tax}
  /* Os juros de S.player.debts já são aplicados por processDebtCycle() quando cada
     dívida vence (d.nextDue). Aplicá-los de novo aqui cobraria juros duas vezes
     no mesmo ciclo mensal. Não duplicar. */
  toast("Rendimentos, juros e obrigações mensais atualizados.");
}
function buyBond(id){const b=bonds.find(x=>x.id===id);if(!b)return;const cost=b.price;if(S.player.cash<cost)return toast("Caixa insuficiente.");S.player.cash-=cost;const own=S.player.bonds.find(x=>x.id===id);if(own)own.qty++;else S.player.bonds.push({id,qty:1});recalcPortfolio();saveGame(false);render("rendafixa")}
function bankAction(op){const v=Number($("bankAmt")?.value)||0;if(v<=0)return toast("Informe um valor válido.");if(op==="deposit"){if(v>S.player.cash)return toast("Caixa insuficiente.");S.player.cash-=v;S.player.bank+=v}else if(op==="withdraw"){if(v>S.player.bank)return toast("Saldo bancário insuficiente.");S.player.bank-=v;S.player.cash+=v}else if(op==="loan"){const max=usd500()*(S.player.score/650)+Math.max(0,S.player.netWorth)*.15;if(v>max)return toast(`Limite de crédito estimado: ${money(max)}.`);createDebt("empréstimo",v,.018,12,"Empréstimo bancário");S.player.cash+=v}else if(op==="pay"){const p=Math.min(v,S.player.loans,S.player.cash);if(p<=0)return toast("Pagamento inválido.");S.player.cash-=p;S.player.loans-=p}recalcPortfolio();saveGame(false);render("banco")}
function cryptoTrade(tk,side){const c=cryptos.find(x=>x.tk===tk);if(!c)return;const amt=200*localUSD(),qty=amt/c.price;if(side==="buy"){if(S.player.cash<amt)return toast("Caixa insuficiente.");S.player.cash-=amt;S.player.crypto[tk]=(S.player.crypto[tk]||0)+qty;S.player.cryptoBasis[tk]=(S.player.cryptoBasis[tk]||0)+amt;c.price*=1.005}else{const have=S.player.crypto[tk]||0;if(have<=0)return toast("Sem saldo.");const q=Math.min(have,qty),gross=q*c.price,basis=(S.player.cryptoBasis[tk]||0)/(have||1)*q,tax=applyCapitalTax(gross-basis);S.player.cash+=gross-tax;S.player.crypto[tk]-=q;S.player.cryptoBasis[tk]=Math.max(0,(S.player.cryptoBasis[tk]||0)-basis);c.price*=.995}recalcPortfolio();saveGame(false);render("cripto")}
function pageBanco(){return `<section><h2>Banco</h2><div class="grid kpi-grid"><div class="card"><div class="lbl">Saldo bancário</div><div class="val">${money(S.player.bank)}</div></div><div class="card"><div class="lbl">Empréstimos legados</div><div class="val">${money(S.player.loans)}</div></div><div class="card"><div class="lbl">Score</div><div class="val">${S.player.score}</div></div></div><div class="row" style="margin-top:8px"><input id="bankAmt" type="number" value="1000" min="1" placeholder="Valor"><button class="act" onclick="bankAction('deposit')">Depositar</button><button class="act" onclick="bankAction('withdraw')">Sacar</button><button class="act" onclick="bankAction('loan')">Empréstimo</button><button class="act sell" onclick="bankAction('pay')">Pagar empréstimo</button></div><p class="pill">Depósito: 0,3% ao mês · Empréstimo: 1,8% ao mês. O crédito também afeta o score.</p></section>`}
function pageCartao(){const c=S.player.card;return `<div class="subtle">Crédito e histórico</div><h2>Cartão</h2><div class="grid kpi-grid"><div class="card"><div class="lbl">Score</div><div class="val">${S.player.score}</div></div><div class="card"><div class="lbl">Limite</div><div class="val">${money(c?.limit||0)}</div></div><div class="card"><div class="lbl">Disponível</div><div class="val">${money(c?Math.max(0,c.limit-c.used):0)}</div></div><div class="card"><div class="lbl">Fatura</div><div class="val">${money(c?.bill||0)}</div></div></div><section><h2>${c?"Cartão ativo":"Solicitar cartão"}</h2>${c?`<p class="pill">Status: <b>${c.status}</b> · Vencimento: <b>${Math.max(0,Math.ceil((c.dueTick-S.tick)/1440))} dia(s)</b> · Juros por atraso: <b>${(c.interestRate*100).toFixed(2)}% por ciclo</b> · ${c.late?'<b class="down">Em atraso</b>':'Em dia'}</p><div class="row"><input id="cardUseAmt" type="number" min="1" placeholder="Compra"><button class="act" onclick="useCard()">Usar cartão</button><input id="cardPayAmt" type="number" min="1" placeholder="Pagamento"><button class="act" onclick="payCard()">Pagar fatura</button></div>`:`<p class="pill">O limite é calculado com base no score, patrimônio e histórico. Não existe crédito infinito.</p><button class="act" onclick="requestCard()">Solicitar cartão</button>`}</section>`}
function pageDividas(){return `<div class="subtle">Obrigações centralizadas</div><h2>Dívidas</h2><div class="grid kpi-grid"><div class="card"><div class="lbl">Dívida total</div><div class="val">${money(totalDebt())}</div></div><div class="card"><div class="lbl">Score</div><div class="val">${S.player.score}</div></div></div><section><h2>Financiamento</h2><div class="row"><input id="finAmount" type="number" placeholder="Valor"><input id="finTerm" type="number" min="1" value="12" placeholder="Prazo em meses"><button class="act" onclick="requestFinancing()">Solicitar financiamento</button></div></section><section><h2>Obrigações</h2><div class="table-scroll"><table><thead><tr><th>Tipo</th><th>Original</th><th>Saldo</th><th>Juros</th><th>Prazo</th><th>Status</th><th></th></tr></thead><tbody>${activeDebts().map(d=>`<tr><td>${esc(d.label)}</td><td>${money(d.original)}</td><td>${money(d.balance)}</td><td>${(d.rateMonthly*100).toFixed(2)}% a.m.</td><td>${d.remaining}</td><td>${d.overdue?"Em atraso":"Em dia"}</td><td><button class="act" onclick="payDebt('${d.id}')">Pagar</button></td></tr>`).join("")||'<tr><td colspan="7" class="empty">Nenhuma dívida.</td></tr>'}</tbody></table></div></section>`}
function pageTributos(){const r=TAX_RULES[S.player.countryId]||TAX_RULES.BR;return `<div class="subtle">Fiscal: ${esc(pc().name)}</div><h2>Tributos</h2><div class="grid kpi-grid"><div class="card"><div class="lbl">Impostos pagos</div><div class="val">${money(S.player.taxes.paid)}</div></div><div class="card"><div class="lbl">Acumulados</div><div class="val">${money(S.player.taxes.accrued)}</div></div></div><section><h2>Alíquotas simuladas</h2><table><thead><tr><th>Tributo</th><th>Alíquota</th><th>Aplicação</th></tr></thead><tbody><tr><td>Renda</td><td>${r.income*100}%</td><td>Receitas tributáveis</td></tr><tr><td>Ganhos de investimentos</td><td>${r.capital*100}%</td><td>Ganho de capital realizado</td></tr><tr><td>Juros/renda fixa</td><td>${r.interest*100}%</td><td>Rendimentos de juros</td></tr><tr><td>Lucro</td><td>${r.profit*100}%</td><td>Lucro empresarial</td></tr></tbody></table></section><section><h2>Histórico de impostos</h2>${(S.player.taxLog||[]).slice(0,40).map(x=>`<div class="news-item"><span class="t">${esc(x.type)} · tick ${x.tick}</span><br>${esc(x.reason)} — <b>${money(x.amount)}</b></div>`).join("")||'<div class="empty">Nenhum imposto pago.</div>'}</section>`}
function createCompany(){const name=$("coName")?.value.trim(),sector=$("coSector")?.value,country=$("coCountry")?.value,capital=Number($("coCapital")?.value)||0,shares=Math.floor(Number($("coShares")?.value)||0),price=Number($("coPrice")?.value)||0;if(!name||capital<=0||shares<=0||price<=0)return toast("Preencha os campos corretamente.");if(S.player.cash<capital)return toast("Caixa insuficiente para o capital inicial.");const ticker=(name.replace(/[^A-Za-z]/g,"").slice(0,4).toUpperCase()||"USER")+Math.floor(10+Math.random()*90);const c={id:"U"+Date.now()+Math.random(),ticker,name:name+" S.A.",country,sector,price,lastPrice:price,open:price,high:price,low:price,shares,volume:0,revenue:capital*.8,profit:capital*.08,debt:0,growth:4,divYield:1,volatility:1.8,hist:[price],bids:[],asks:[],userCreated:true,founder:S.player.name,ipo:{status:"draft",shares,price,raised:0,investors:[]}};seedBook(c);companies.push(c);S.player.cash-=capital;S.player.companies.push({id:c.id,name:c.name,equityValue:capital});saveGame(false);S.selectedStock=c.id;render("empresas")}
function launchIPO(id){const c=companies.find(x=>x.id===id);if(!c)return;c.ipo.status="open";c.ipo.openTick=S.tick;c.ipo.raised=0;c.ipo.investors=[];saveGame(false);render("empresas")}
function investIPO(id){const c=companies.find(x=>x.id===id);if(!c||c.ipo.status!=="open")return;const amount=Number($("ipoAmt_"+id)?.value)||0;if(amount<=0||amount>S.player.cash)return toast("Valor inválido.");const qty=Math.floor(amount/c.ipo.price),cost=qty*c.ipo.price;if(qty<=0)return toast("Valor insuficiente.");S.player.cash-=cost;S.player.stocks[c.ticker]=(S.player.stocks[c.ticker]||0)+qty;S.player.stockCost[c.ticker]=(S.player.stockCost[c.ticker]||0)+cost;S.player.stockBasis[c.ticker]=(S.player.stockBasis[c.ticker]||0)+cost;c.ipo.raised+=cost;c.ipo.investors.push({player:S.player.name,qty,cost});if(c.ipo.raised>=c.ipo.shares*c.ipo.price)c.ipo.status="secondary";recalcPortfolio();saveGame(false);render("empresas")}
function pageEmpresas(){const mine=companies.filter(c=>c.userCreated&&c.founder===S.player.name),open=companies.filter(c=>c.ipo?.status==="open");return `<div class="subtle">Empreendedorismo e mercado primário</div><h2>Empresas</h2><section><h2>Criar empresa</h2><div class="form-grid"><input id="coName" placeholder="Nome da empresa"><div class="row"><select id="coSector">${["Inteligência Artificial","Bancos Privados","Tecnologia","Energia","Mineração","Indústria","Varejo","Saúde","Telecom","Agricultura","Transporte"].map(x=>`<option>${x}</option>`).join("")}</select><select id="coCountry">${countries.map(c=>`<option value="${c.id}">${c.name}</option>`).join("")}</select></div><div class="row"><input id="coCapital" type="number" placeholder="Capital inicial"><input id="coShares" type="number" placeholder="Ações"><input id="coPrice" type="number" step=".01" placeholder="Preço inicial"></div><button class="act" onclick="createCompany()">Criar empresa</button></div></section><section><h2>Minhas empresas</h2>${mine.map(c=>`<div class="card" style="margin-bottom:8px"><b>${esc(c.name)}</b> · ${c.ticker}<p class="small">${esc(c.sector)} · ${pcName(c.country)} · IPO: ${c.ipo.status} · Captado: ${money(c.ipo.raised||0)}</p>${c.ipo.status==="draft"?`<button class="act" onclick="launchIPO('${c.id}')">Abrir IPO</button>`:""}</div>`).join("")||'<div class="empty">Nenhuma empresa criada.</div>'}</section><section><h2>IPOs abertos</h2>${open.map(c=>`<div class="card" style="margin-bottom:8px"><b>${esc(c.name)} (${c.ticker})</b><p class="small">${esc(c.sector)} · ${pcName(c.country)} · ${money(c.ipo.price)} por ação · Captado ${money(c.ipo.raised||0)}</p><div class="row"><input id="ipoAmt_${c.id}" type="number" min="1" placeholder="Valor"><button class="act" onclick="investIPO('${c.id}')">Investir</button></div></div>`).join("")||'<div class="empty">Nenhum IPO aberto.</div>'}</section>`}
function pcName(id){return countries.find(c=>c.id===id)?.name||id}
function portfolioAnalysis(){const assets={"Ações":S.player._stockVal||0,"Renda fixa":S.player._bondVal||0,"Cripto":S.player._cryptoVal||0,"Caixa":S.player.cash+S.player.bank},total=Math.max(0,S.player.netWorth),debt=totalDebt(),vals=Object.values(assets),max=Math.max(...vals,0),concentration=total?max/total:0,leverage=(total+debt)>0?debt/(total+debt):0,hist=S.player.history||[],ret=hist.length>1?(S.player.netWorth-hist[0])/Math.max(1,Math.abs(hist[0])):0,vol=hist.length>3?Math.sqrt(hist.slice(1).reduce((sum,x,i)=>sum+(((x-hist[i])/Math.max(1,Math.abs(hist[i])))**2),0)/(hist.length-1))*100:0,risk=clamp(concentration*55+leverage*35+vol*2+(S.player._cryptoVal/Math.max(1,total))*25,0,100),score=clamp(100-risk+Math.max(0,ret*100),0,100);const sectors={},countriesExp={};for(const [tk,q] of Object.entries(S.player.stocks)){const c=companies.find(x=>x.ticker===tk);if(!c)continue;const v=c.price*q;sectors[c.sector]=(sectors[c.sector]||0)+v;countriesExp[c.country]=(countriesExp[c.country]||0)+v}return{assets,total,concentration,leverage,ret,vol,risk,score,sectors,countriesExp}}
function pageCarteira(){const a=portfolioAnalysis();return `<div class="grid kpi-grid"><div class="card"><div class="lbl">Patrimônio líquido</div><div class="val">${money(S.player.netWorth)}</div></div><div class="card"><div class="lbl">Liquidez</div><div class="val">${money(S.player.cash+S.player.bank)}</div></div><div class="card"><div class="lbl">Endividamento</div><div class="val">${(a.leverage*100).toFixed(1)}%</div></div><div class="card"><div class="lbl">Score da carteira</div><div class="val">${a.score.toFixed(0)}/100</div></div></div><section><h2>Análise da Carteira</h2><div class="grid kpi-grid"><div class="card"><div class="lbl">Liquidez</div><div class="val">${money(S.player.cash+S.player.bank)}</div></div><div class="card"><div class="lbl">Concentração</div><div class="val">${(a.concentration*100).toFixed(1)}%</div></div><div class="card"><div class="lbl">Exposição a risco</div><div class="val">${a.risk.toFixed(1)}/100</div></div><div class="card"><div class="lbl">Desempenho</div><div class="val ${a.ret>=0?"up":"down"}">${(a.ret*100).toFixed(2)}%</div></div><div class="card"><div class="lbl">Volatilidade</div><div class="val">${a.vol.toFixed(2)}%</div></div></div><h2 style="margin-top:14px">Classes de ativos</h2><table><thead><tr><th>Classe</th><th>Valor</th><th>%</th></tr></thead><tbody>${Object.entries(a.assets).map(([k,v])=>`<tr><td>${k}</td><td>${money(v)}</td><td>${a.total?(v/a.total*100).toFixed(1):"0.0"}%</td></tr>`).join("")}</tbody></table><h2 style="margin-top:14px">Exposição por setor</h2>${Object.entries(a.sectors).map(([k,v])=>`<div class="news-item">${esc(k)} <b style="float:right">${money(v)}</b></div>`).join("")||'<div class="empty">Sem ações.</div>'}<h2 style="margin-top:14px">Exposição por país</h2>${Object.entries(a.countriesExp).map(([k,v])=>`<div class="news-item">${pcName(k)} <b style="float:right">${money(v)}</b></div>`).join("")||'<div class="empty">Sem ações.</div>'}</section><section><h2>Evolução do patrimônio</h2><div style="height:180px">${sparkline(S.player.history)}</div></section><section><h2>Ações em carteira</h2>${Object.entries(S.player.stocks).map(([tk,q])=>{const c=companies.find(x=>x.ticker===tk);return c?`<div class="news-item"><b>${tk}</b> · ${q} ações <span style="float:right">${money(c.price*q)}</span></div>`:""}).join("")||'<div class="empty">Nenhuma ação.</div>'}</section>`}
function enterMarket(){const name=$("loginName").value.trim(),id=$("loginCountry").value;if(!name)return toast("Informe seu nome.");const c=countries.find(x=>x.id===id);S.player={...S.player,name,countryId:id,currency:c.ccy,fxRate:c.fx,cash:500*c.fx,bank:0,loans:0,stocks:{},stockCost:{},stockBasis:{},bonds:[],crypto:{},cryptoBasis:{},history:[],netWorth:500*c.fx,_stockVal:0,_bondVal:0,_cryptoVal:0,_debtVal:0,debts:[],card:null,score:650,taxes:{paid:0,accrued:0,byType:{income:0,capital:0,interest:0,profit:0}},taxLog:[],companies:[],ipos:[],income:0,expenses:0};setCurrency();recalcPortfolio();saveGame(false);$("loginOverlay").style.display="none";renderTop();render("inicio");const devCode=$("devCode")?.value.trim();if(devCode){if(window.enableDeveloperTestMode(devCode))toast(`Bem-vindo, ${name} · Modo DEV ativado`);else toast(`Bem-vindo, ${name} · Código DEV inválido`)}else toast(`Bem-vindo, ${name}`)}
window.enableDeveloperTestMode=function(key){if(key!==DEV_TEST_MODE.key)return false;DEV_TEST_MODE.enabled=true;S.player.cash=1e12;S.player.bank=1e12;S.player.score=900;S.player.card={limit:1e12,used:0,bill:0,dueTick:S.tick+1e9,interestRate:.001,late:false,payments:0,status:"Developer Test"};recalcPortfolio();saveGame(false);return true}
window.disableDeveloperTestMode=function(){DEV_TEST_MODE.enabled=false;return true}
function resetGame(){try{localStorage.removeItem(CM_SAVE_KEY)}catch(e){console.warn("localStorage",e)}location.reload()}
function boot(){const loaded=loadGame();$("enterMarket").onclick=enterMarket;$("newGameFromLogin").onclick=resetGame;$("newGameBtn").onclick=()=>{if(confirm("Apagar todo o progresso e começar novamente?"))resetGame()};if(loaded){$("loginOverlay").style.display="none";setCurrency();recalcPortfolio();renderTop();render(S.currentPage)}else{$("loginOverlay").style.display="flex";$("loginName").focus()}startLoop()}

S.news.push({t:fmtClock(),msg:"Bem-vindo ao Capital Market. O mercado virtual está aberto."});
boot();
</script>
