*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:var(--bg);color:var(--txt)}
body{padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}
button,input,select{font:inherit}
button{cursor:pointer}
.app{display:flex;min-height:100vh}
nav{width:178px;background:var(--panel);border-right:1px solid var(--line);padding:14px 8px;flex-shrink:0;position:sticky;top:0;height:100vh;overflow-y:auto}
