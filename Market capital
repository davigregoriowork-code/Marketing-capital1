button.act{background:var(--accent);border:0;color:#04121f;padding:8px 12px;border-radius:6px;font-weight:600;font-size:13px}
button.sell{background:var(--down);color:#1a0507}
  nav{width:62px;padding:10px 5px}
  nav h1{display:none}
  nav button{font-size:10px;text-align:center;padding:9px 2px}
  main{padding:10px}
  .col{min-width:100%}
  .topbar{gap:8px}
