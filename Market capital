function stockRows(list){
  return `<table><thead><tr><th>Ticker</th><th>Empresa</th><th>Preço</th><th>Var.</th><th>Volume</th></tr></thead><tbody>
  ${list.map(c=>{
    const v=(c.price-c.open)/c.open*100;
    return `<tr onclick="selectStock('${c.id}')"><td>${esc(c.ticker)}</td><td>${esc(c.name)}</td><td>${money(c.price)}</td><td class="${v>=0?"up":"down"}">${v>=0?"+":""}${v.toFixed(2)}%</td><td>${num(c.volume)}</td></tr>`;
  }).join("")}</tbody></table>`;
}

